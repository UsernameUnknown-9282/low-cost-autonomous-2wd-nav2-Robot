<?xml version="1.0"?>
<!-- ========================================================================= -->
<!-- 2WD Differential Drive Robot URDF Model                                   -->
<!-- Chassis: Low-cost acrylic 2WD chassis with 2x Yellow TT DC Motors         -->
<!-- LiDAR: LDROBOT LD19 mounted at x=+0.040m, z=+0.100m                       -->
<!-- Odometry: Pure LiDAR Odometry (RF2O) - Gazebo diff_drive odom disabled    -->
<!-- ========================================================================= -->
<robot name="diff_drive_2wd">

  <!-- Color Definitions -->
  <material name="acrylic_clear">
    <color rgba="0.2 0.6 0.9 0.6"/>
  </material>
  <material name="motor_yellow">
    <color rgba="0.95 0.8 0.1 1.0"/>
  </material>
  <material name="tire_black">
    <color rgba="0.15 0.15 0.15 1.0"/>
  </material>
  <material name="lidar_blue">
    <color rgba="0.1 0.2 0.8 1.0"/>
  </material>
  <material name="caster_metal">
    <color rgba="0.8 0.8 0.8 1.0"/>
  </material>

  <!-- ===================================================================== -->
  <!-- Base Footprint (Ground Projection REP-105)                            -->
  <!-- ===================================================================== -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0.0 0.0 0.033" rpy="0 0 0"/>
  </joint>

  <!-- ===================================================================== -->
  <!-- Base Link (Chassis origin at wheel axle center)                       -->
  <!-- ===================================================================== -->
  <link name="base_link">
    <inertial>
      <origin xyz="0.01 0.0 0.02" rpy="0 0 0"/>
      <mass value="0.850"/>
      <!-- I = m/12 * (w^2 + h^2) etc for box 0.21 x 0.15 x 0.05 -->
      <inertia ixx="0.00177" ixy="0.0" ixz="0.0"
               iyy="0.00330" iyz="0.0"
               izz="0.00472"/>
    </inertial>
    <!-- Acrylic Main Base Plate -->
    <visual>
      <origin xyz="0.0 0.0 0.015" rpy="0 0 0"/>
      <geometry>
        <box size="0.210 0.150 0.030"/>
      </geometry>
      <material name="acrylic_clear"/>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.015" rpy="0 0 0"/>
      <geometry>
        <box size="0.210 0.150 0.030"/>
      </geometry>
    </collision>
  </link>

  <!-- ===================================================================== -->
  <!-- Left Wheel (Yellow TT DC Motor + 66mm Rubber Tire)                    -->
  <!-- ===================================================================== -->
  <link name="wheel_left">
    <inertial>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
      <mass value="0.045"/>
      <inertia ixx="0.000014" ixy="0.0" ixz="0.0"
               iyy="0.000024" iyz="0.0"
               izz="0.000014"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.033" length="0.026"/>
      </geometry>
      <material name="tire_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.033" length="0.026"/>
      </geometry>
    </collision>
  </link>

  <joint name="wheel_left_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_left"/>
    <origin xyz="0.0 0.0825 0.0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- ===================================================================== -->
  <!-- Right Wheel (Yellow TT DC Motor + 66mm Rubber Tire)                   -->
  <!-- ===================================================================== -->
  <link name="wheel_right">
    <inertial>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
      <mass value="0.045"/>
      <inertia ixx="0.000014" ixy="0.0" ixz="0.0"
               iyy="0.000024" iyz="0.0"
               izz="0.000014"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.033" length="0.026"/>
      </geometry>
      <material name="tire_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.033" length="0.026"/>
      </geometry>
    </collision>
  </link>

  <joint name="wheel_right_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_right"/>
    <origin xyz="0.0 -0.0825 0.0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- ===================================================================== -->
  <!-- Front Caster Ball (Smooth omni-directional support)                    -->
  <!-- ===================================================================== -->
  <link name="caster_wheel">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.020"/>
      <inertia ixx="0.000002" ixy="0.0" ixz="0.0"
               iyy="0.000002" iyz="0.0"
               izz="0.000002"/>
    </inertial>
    <visual>
      <geometry>
        <sphere radius="0.015"/>
      </geometry>
      <material name="caster_metal"/>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.015"/>
      </geometry>
    </collision>
  </link>

  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_wheel"/>
    <!-- Radius is 0.015m, base_link is at z=0.033m -> z = -0.018m places bottom at ground 0.0m -->
    <origin xyz="0.080 0.0 -0.018" rpy="0 0 0"/>
  </joint>

  <!-- ===================================================================== -->
  <!-- LDROBOT LD19 / D200 LiDAR Sensor                                      -->
  <!-- Elevation: x=+0.040m, y=0.0m, z=+0.100m above base_link               -->
  <!-- Matches static TF tree from Module 2: base_link -> laser_frame        -->
  <!-- ===================================================================== -->
  <link name="laser_frame">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.042"/>
      <inertia ixx="0.000010" ixy="0.0" ixz="0.0"
               iyy="0.000010" iyz="0.0"
               izz="0.000015"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.019" length="0.038"/>
      </geometry>
      <material name="lidar_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.019" length="0.038"/>
      </geometry>
    </collision>
  </link>

  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_frame"/>
    <origin xyz="0.040 0.0 0.100" rpy="0 0 0"/>
  </joint>

  <!-- ===================================================================== -->
  <!-- Gazebo Friction & Surface Properties                                  -->
  <!-- ===================================================================== -->
  <gazebo reference="wheel_left">
    <mu1>1.5</mu1>
    <mu2>1.5</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <material>Gazebo/FlatBlack</material>
  </gazebo>

  <gazebo reference="wheel_right">
    <mu1>1.5</mu1>
    <mu2>1.5</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <material>Gazebo/FlatBlack</material>
  </gazebo>

  <gazebo reference="caster_wheel">
    <mu1>0.001</mu1>
    <mu2>0.001</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <material>Gazebo/Grey</material>
  </gazebo>

  <gazebo reference="base_link">
    <material>Gazebo/BlueTransparent</material>
  </gazebo>

  <gazebo reference="laser_frame">
    <material>Gazebo/Blue</material>
  </gazebo>

  <!-- ===================================================================== -->
  <!-- Gazebo Diff Drive Plugin (Wheel Actuation Only)                       -->
  <!-- NOTE: publish_odom and publish_odom_tf are intentionally FALSE        -->
  <!-- Pure LiDAR Odometry (RF2O) computes /odom and odom->base_footprint TF -->
  <!-- ===================================================================== -->
  <gazebo>
    <plugin name="gazebo_diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros>
        <remapping>/cmd_vel:=cmd_vel</remapping>
      </ros>
      <update_rate>30</update_rate>
      <left_joint>wheel_left_joint</left_joint>
      <right_joint>wheel_right_joint</right_joint>
      <wheel_separation>0.165</wheel_separation>
      <wheel_diameter>0.066</wheel_diameter>
      <max_wheel_torque>2.0</max_wheel_torque>
      <max_wheel_acceleration>3.0</max_wheel_acceleration>
      <command_topic>cmd_vel</command_topic>
      <!-- Pure LiDAR Odometry: Disable wheel odometry publishing & TF broadcast -->
      <publish_odom>false</publish_odom>
      <publish_odom_tf>false</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
    </plugin>
  </gazebo>

  <!-- ===================================================================== -->
  <!-- Gazebo Joint State Publisher                                          -->
  <!-- ===================================================================== -->
  <gazebo>
    <plugin name="gazebo_joint_state_publisher" filename="libgazebo_ros_joint_state_publisher.so">
      <update_rate>30</update_rate>
      <joint_name>wheel_left_joint</joint_name>
      <joint_name>wheel_right_joint</joint_name>
    </plugin>
  </gazebo>

  <!-- ===================================================================== -->
  <!-- Gazebo LiDAR Ray Sensor Plugin                                        -->
  <!-- Emulates LDROBOT LD19 360-degree scan @ 10 Hz, publishing to /scan    -->
  <!-- ===================================================================== -->
  <gazebo reference="laser_frame">
    <sensor type="ray" name="ld19_laser_sensor">
      <pose>0 0 0 0 0 0</pose>
      <visualize>false</visualize>
      <update_rate>10.0</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>450</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159265</min_angle>
            <max_angle>3.14159265</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.05</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.005</stddev>
        </noise>
      </ray>
      <plugin name="gazebo_ros_laser" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <remapping>~/out:=scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>laser_frame</frame_name>
      </plugin>
    </sensor>
  </gazebo>

</robot>
